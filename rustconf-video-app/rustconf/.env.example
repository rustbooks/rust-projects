# ── RustConf Environment Variables ──────────────────────────────────────────
# Copy to .env and fill in values. Never commit .env to git.

# ── Server ────────────────────────────────────────────────────────────────────
BIND_ADDR=0.0.0.0:3000

# ── Security ─────────────────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
JWT_SECRET=change-me-to-64-random-hex-chars-in-production

# ── Database ─────────────────────────────────────────────────────────────────
# SQLite (default, zero setup):
DATABASE_URL=sqlite:./data.db

# PostgreSQL (production alternative, install sqlx feature = "postgres"):
# DATABASE_URL=postgres://user:pass@localhost:5432/rustconf

# ── TURN server ───────────────────────────────────────────────────────────────
# Required for clients behind NAT (corporate networks, mobile)
TURN_USER=rustconf
TURN_PASS=change-me-in-production
TURN_HOST=turn.yourdomain.com
TURN_PORT=3478

# ── Logging ───────────────────────────────────────────────────────────────────
# Options: error | warn | info | debug | trace
RUST_LOG=info,rustconf_backend=debug

# ── Optional: Reverse proxy / domain ─────────────────────────────────────────
PUBLIC_URL=https://meet.yourdomain.com
