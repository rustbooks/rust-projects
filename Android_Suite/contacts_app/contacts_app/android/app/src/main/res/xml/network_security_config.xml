<?xml version="1.0" encoding="utf-8"?>
<!--
    android/app/src/main/res/xml/network_security_config.xml
    This app is fully offline — block all cleartext traffic as a defense-in-depth measure.
    If network features are added in the future, explicit domains must be whitelisted here.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
