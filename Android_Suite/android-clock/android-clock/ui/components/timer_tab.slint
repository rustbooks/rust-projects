// ui/components/timer_tab.slint
// ============================================================================
// Timer Tab — Countdown timer with circular progress indicator
// ============================================================================

import { MaterialTheme } from "../app.slint";

// Circular progress ring drawn with Slint Path
component CircularProgress {
    in property <float> progress: 0.0; // 0.0 to 1.0
    in property <string> center-text: "00:00:00";
    in property <color> ring-color: MaterialTheme.primary;

    min-width: 260px;
    min-height: 260px;

    property <length> cx: self.width / 2;
    property <length> cy: self.height / 2;
    property <length> radius: min(self.width, self.height) / 2 - 20px;
    property <length> stroke-width: 10px;

    // Background ring
    Rectangle {
        x: root.cx - root.radius;
        y: root.cy - root.radius;
        width: root.radius * 2;
        height: root.radius * 2;
        border-radius: root.radius;
        border-width: root.stroke-width;
        border-color: MaterialTheme.surface-variant;
        background: MaterialTheme.surface-1;
    }

    // Center time display
    VerticalLayout {
        alignment: center;

        Text {
            text: root.center-text;
            font-size: 48px;
            font-weight: 300;
            color: MaterialTheme.on-surface;
            horizontal-alignment: center;
            letter-spacing: -1px;
        }
    }

    // Progress arc would use Path element in full implementation.
    // Here we approximate with a colored rectangle indicator.
    Rectangle {
        x: root.cx - root.radius - 2px;
        y: root.cy - root.radius - 2px;
        width: (root.radius + 2px) * 2;
        height: (root.radius + 2px) * 2;
        border-radius: (root.radius + 2px);
        border-width: root.stroke-width + 2px;
        border-color: root.progress > 0 ? root.ring-color : transparent;
        background: transparent;
        opacity: root.progress;

        animate opacity { duration: 200ms; }
        animate border-color { duration: 300ms; }
    }
}

// Number picker for setting timer duration
component NumberPicker {
    in property <int> value: 0;
    in property <int> max-value: 59;
    in property <string> label: "";
    callback changed(int);

    width: 80px;

    VerticalLayout {
        spacing: 4px;
        alignment: center;

        // Up button
        Rectangle {
            height: 40px;
            border-radius: 20px;
            background: MaterialTheme.surface-variant;

            Text {
                text: "▲";
                font-size: 18px;
                color: MaterialTheme.on-surface;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.changed((root.value + 1) % (root.max-value + 1));
                }
            }
        }

        // Value display
        Text {
            text: root.value < 10 ? "0" + root.value : root.value;
            font-size: 48px;
            font-weight: 300;
            color: MaterialTheme.on-surface;
            horizontal-alignment: center;
        }

        // Down button
        Rectangle {
            height: 40px;
            border-radius: 20px;
            background: MaterialTheme.surface-variant;

            Text {
                text: "▼";
                font-size: 18px;
                color: MaterialTheme.on-surface;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.changed(root.value == 0 ? root.max-value : root.value - 1);
                }
            }
        }

        if root.label != "": Text {
            text: root.label;
            font-size: MaterialTheme.label-medium;
            color: MaterialTheme.on-surface-variant;
            horizontal-alignment: center;
            letter-spacing: 1px;
        }
    }
}

// Material 3 outlined button
component OutlinedButton {
    in property <string> text;
    in property <bool> filled: false;
    callback clicked;

    height: 48px;
    min-width: 100px;

    Rectangle {
        border-radius: 24px;
        background: root.filled ? MaterialTheme.primary : transparent;
        border-width: root.filled ? 0px : 1px;
        border-color: MaterialTheme.outline;

        Text {
            text: root.text;
            font-size: MaterialTheme.label-large;
            font-weight: 600;
            color: root.filled ? MaterialTheme.on-primary : MaterialTheme.primary;
            horizontal-alignment: center;
            vertical-alignment: center;
            padding-left: 24px;
            padding-right: 24px;
        }

        TouchArea {
            mouse-cursor: pointer;
            clicked => { root.clicked(); }
        }
    }
}

export component TimerTab {
    in-out property <int> timer-hours: 0;
    in-out property <int> timer-minutes: 5;
    in-out property <int> timer-seconds: 0;
    in property <bool> timer-running: false;
    in property <string> timer-display: "00:05:00";
    in property <float> timer-progress: 0.0;

    callback start-pause(int, int, int);
    callback reset();

    background: MaterialTheme.surface;

    VerticalLayout {
        alignment: center;
        spacing: 24px;
        padding: 24px;

        // App bar title
        Text {
            text: "Timer";
            font-size: MaterialTheme.headline-medium;
            font-weight: 600;
            color: MaterialTheme.on-surface;
            horizontal-alignment: center;
        }

        // Circular progress + time display
        CircularProgress {
            progress: root.timer-progress;
            center-text: root.timer-display;
            ring-color: root.timer-running
                ? MaterialTheme.primary
                : MaterialTheme.secondary;
            horizontal-alignment: center;
        }

        // Time picker (shown when not running)
        if !root.timer-running: Rectangle {
            height: 140px;

            HorizontalLayout {
                alignment: center;
                spacing: 8px;

                NumberPicker {
                    value: root.timer-hours;
                    max-value: 23;
                    label: "HRS";
                    changed(v) => { root.timer-hours = v; }
                }

                Text {
                    text: ":";
                    font-size: 48px;
                    font-weight: 300;
                    color: MaterialTheme.on-surface-variant;
                    vertical-alignment: center;
                }

                NumberPicker {
                    value: root.timer-minutes;
                    max-value: 59;
                    label: "MIN";
                    changed(v) => { root.timer-minutes = v; }
                }

                Text {
                    text: ":";
                    font-size: 48px;
                    font-weight: 300;
                    color: MaterialTheme.on-surface-variant;
                    vertical-alignment: center;
                }

                NumberPicker {
                    value: root.timer-seconds;
                    max-value: 59;
                    label: "SEC";
                    changed(v) => { root.timer-seconds = v; }
                }
            }
        }

        // Control buttons
        HorizontalLayout {
            alignment: center;
            spacing: 16px;

            OutlinedButton {
                text: "Reset";
                clicked => { root.reset(); }
            }

            OutlinedButton {
                text: root.timer-running ? "⏸ Pause" : "▶ Start";
                filled: true;
                clicked => {
                    root.start-pause(root.timer-hours, root.timer-minutes, root.timer-seconds);
                }
            }
        }
    }
}
