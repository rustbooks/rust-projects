// ui/components/alarm_tab.slint
// ============================================================================
// Alarm Tab — List of alarms with enable/disable toggle and swipe-to-delete
// ============================================================================

import { MaterialTheme, AlarmItem, FAB } from "../app.slint";

// Individual alarm card with Material 3 styling
component AlarmCard {
    in property <AlarmItem> alarm;
    in property <int> index;
    callback toggle(bool);
    callback delete();

    height: 96px;

    // Swipe state for gesture-based deletion
    property <length> swipe-x: 0;
    property <bool> deleting: swipe-x < -80px;

    Rectangle {
        x: root.swipe-x;
        width: parent.width;
        height: parent.height;
        background: root.alarm.is-enabled
            ? MaterialTheme.surface-1
            : MaterialTheme.surface;
        border-radius: 16px;
        clip: false;

        // Elevation shadow (only when enabled)
        drop-shadow-blur: root.alarm.is-enabled ? 4px : 0px;
        drop-shadow-color: #00000015;
        drop-shadow-offset-y: root.alarm.is-enabled ? 2px : 0px;

        animate background { duration: 300ms; easing: ease-out; }
        animate drop-shadow-blur { duration: 300ms; }

        HorizontalLayout {
            padding: 20px;
            spacing: 16px;
            alignment: space-between;

            VerticalLayout {
                alignment: center;
                spacing: 4px;

                // Time display — large and prominent
                Text {
                    text: root.alarm.time-display;
                    font-size: 40px;
                    font-weight: 300;
                    color: root.alarm.is-enabled
                        ? MaterialTheme.on-surface
                        : MaterialTheme.on-surface-variant;
                    letter-spacing: -1px;

                    animate color { duration: 300ms; }
                }

                // Label and repeat days
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;

                    if root.alarm.label != "": Text {
                        text: root.alarm.label;
                        font-size: MaterialTheme.body-medium;
                        color: root.alarm.is-enabled
                            ? MaterialTheme.on-surface
                            : MaterialTheme.on-surface-variant;
                    }

                    if root.alarm.label != "": Text {
                        text: "·";
                        font-size: MaterialTheme.body-medium;
                        color: MaterialTheme.on-surface-variant;
                    }

                    Text {
                        text: root.alarm.repeat-days;
                        font-size: MaterialTheme.body-medium;
                        color: MaterialTheme.on-surface-variant;
                    }
                }
            }

            // Toggle switch (Material 3 style)
            Rectangle {
                width: 52px;
                height: 32px;
                y: (parent.height - 32px) / 2;
                border-radius: 16px;
                background: root.alarm.is-enabled
                    ? MaterialTheme.primary
                    : MaterialTheme.surface-variant;
                border-width: root.alarm.is-enabled ? 0px : 2px;
                border-color: MaterialTheme.outline;

                animate background { duration: 200ms; easing: ease-out; }

                // Thumb
                Rectangle {
                    x: root.alarm.is-enabled ? 24px : 4px;
                    y: (parent.height - (root.alarm.is-enabled ? 24px : 16px)) / 2;
                    width: root.alarm.is-enabled ? 24px : 16px;
                    height: root.alarm.is-enabled ? 24px : 16px;
                    border-radius: root.alarm.is-enabled ? 12px : 8px;
                    background: root.alarm.is-enabled
                        ? MaterialTheme.on-primary
                        : MaterialTheme.outline;
                    drop-shadow-blur: 2px;
                    drop-shadow-color: #00000040;

                    animate x { duration: 200ms; easing: ease-out; }
                    animate width { duration: 200ms; }
                    animate height { duration: 200ms; }
                }

                TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.toggle(!root.alarm.is-enabled);
                    }
                }
            }
        }

        // Delete gesture area
        TouchArea {
            pointer-event(pe) => {
                if pe.kind == PointerEventKind.move {
                    if pe.position.x < 0 {
                        root.swipe-x = max(pe.position.x, -120px);
                    }
                } else if pe.kind == PointerEventKind.up {
                    if root.swipe-x < -80px {
                        root.delete();
                    } else {
                        root.swipe-x = 0;
                    }
                }
            }
        }
    }

    // Delete indicator (revealed on swipe)
    if root.deleting: Rectangle {
        x: parent.width - 80px;
        width: 80px;
        height: parent.height;
        border-radius: 16px;
        background: MaterialTheme.error-container;

        Text {
            text: "🗑";
            font-size: 24px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

// Empty state when no alarms are set
component EmptyAlarmState {
    VerticalLayout {
        alignment: center;
        spacing: 16px;
        padding: 32px;

        Text {
            text: "🔔";
            font-size: 64px;
            horizontal-alignment: center;
        }
        Text {
            text: "No alarms set";
            font-size: MaterialTheme.headline-medium;
            color: MaterialTheme.on-surface;
            horizontal-alignment: center;
            font-weight: 500;
        }
        Text {
            text: "Tap the + button to add your first alarm";
            font-size: MaterialTheme.body-large;
            color: MaterialTheme.on-surface-variant;
            horizontal-alignment: center;
        }
    }
}

export component AlarmTab {
    in property <[AlarmItem]> alarms: [];
    callback toggle-alarm(int, bool);
    callback delete-alarm(int);
    callback add-alarm-clicked();

    background: MaterialTheme.surface;

    // App bar
    Rectangle {
        x: 0; y: 0;
        width: parent.width;
        height: 64px;
        background: MaterialTheme.surface;

        Text {
            x: 24px;
            y: (parent.height - 32px) / 2;
            text: "Alarm";
            font-size: MaterialTheme.headline-medium;
            font-weight: 600;
            color: MaterialTheme.on-surface;
        }
    }

    // Alarm list
    Rectangle {
        y: 64px;
        width: parent.width;
        height: parent.height - 64px;

        if alarms.length == 0: EmptyAlarmState {
            width: parent.width;
            height: parent.height;
        }

        if alarms.length > 0: Flickable {
            width: parent.width;
            height: parent.height - 80px; // Leave room for FAB
            viewport-height: alarms.length * 112px;

            VerticalLayout {
                padding: 16px;
                spacing: 8px;

                for alarm[i] in alarms: AlarmCard {
                    alarm: alarm;
                    index: i;
                    toggle(en) => { root.toggle-alarm(i, en); }
                    delete => { root.delete-alarm(i); }
                }
            }
        }
    }

    // FAB — positioned in bottom-right
    FAB {
        x: parent.width - 72px;
        y: parent.height - 72px;
        icon: "+";
        clicked => { root.add-alarm-clicked(); }
    }
}
