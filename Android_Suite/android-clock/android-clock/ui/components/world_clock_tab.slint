// ui/components/world_clock_tab.slint
// ============================================================================
// World Clock Tab — Multi-timezone time display
// ============================================================================

import { MaterialTheme, WorldClockItem } from "../app.slint";

component WorldClockCard {
    in property <WorldClockItem> clock;

    height: 88px;

    Rectangle {
        width: parent.width;
        height: parent.height;
        background: MaterialTheme.surface-1;
        border-radius: 12px;

        HorizontalLayout {
            padding: 16px;
            spacing: 16px;
            alignment: space-between;

            // Left: City info + day/night icon
            HorizontalLayout {
                spacing: 12px;
                alignment: start;

                // Day/Night indicator
                Rectangle {
                    width: 48px;
                    height: 48px;
                    border-radius: 24px;
                    background: root.clock.is-daytime
                        ? #FFF8E1 // warm yellow for day
                        : #1A237E; // deep blue for night

                    Text {
                        text: root.clock.is-daytime ? "☀" : "🌙";
                        font-size: 22px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                VerticalLayout {
                    alignment: center;
                    spacing: 2px;

                    Text {
                        text: root.clock.city;
                        font-size: MaterialTheme.title-medium;
                        font-weight: 600;
                        color: MaterialTheme.on-surface;
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        Text {
                            text: root.clock.offset-display;
                            font-size: MaterialTheme.body-medium;
                            color: MaterialTheme.on-surface-variant;
                        }
                        if root.clock.diff-display != "Same time": Rectangle {
                            width: 4px;
                            height: 4px;
                            border-radius: 2px;
                            background: MaterialTheme.on-surface-variant;
                            y: 8px;
                        }
                        if root.clock.diff-display != "Same time": Text {
                            text: root.clock.diff-display;
                            font-size: MaterialTheme.body-medium;
                            color: root.clock.diff-display.starts-with("+")
                                ? MaterialTheme.tertiary
                                : MaterialTheme.error;
                        }
                    }
                }
            }

            // Right: Time
            VerticalLayout {
                alignment: center;

                Text {
                    text: root.clock.time-display;
                    font-size: 36px;
                    font-weight: 300;
                    color: MaterialTheme.on-surface;
                    horizontal-alignment: right;
                    letter-spacing: -1px;
                }
            }
        }
    }
}

export component WorldClockTab {
    in property <[WorldClockItem]> clocks: [];

    background: MaterialTheme.surface;

    VerticalLayout {
        // App bar
        Rectangle {
            height: 64px;
            background: MaterialTheme.surface;

            Text {
                x: 24px;
                y: (parent.height - 32px) / 2;
                text: "World Clock";
                font-size: MaterialTheme.headline-medium;
                font-weight: 600;
                color: MaterialTheme.on-surface;
            }
        }

        // World clock list
        Flickable {
            viewport-height: clocks.length * 100px;

            VerticalLayout {
                padding: 16px;
                spacing: 8px;

                for clock in clocks: WorldClockCard {
                    clock: clock;
                    width: parent.width - 32px;
                }
            }
        }
    }
}
