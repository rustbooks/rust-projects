// ui/app.slint
// ============================================================================
// Android Clock — Root UI Component
// ============================================================================
// This is the entry point for the Slint UI. It defines:
//   - All shared data types (structs exposed to Rust)
//   - The AppWindow root component with all properties and callbacks
//   - Tab-based navigation (Clock / Alarm / Timer / Stopwatch / World Clock)
//   - Responsive layout that adapts from phone to tablet/TV
//
// Material 3 Design Tokens are used throughout for consistent theming.
// ============================================================================

import { ClockTab } from "components/clock_tab.slint";
import { AlarmTab } from "components/alarm_tab.slint";
import { TimerTab } from "components/timer_tab.slint";
import { StopwatchTab } from "components/stopwatch_tab.slint";
import { WorldClockTab } from "components/world_clock_tab.slint";
import { AddAlarmDialog } from "components/add_alarm_dialog.slint";

// ── Shared Data Types ────────────────────────────────────────────────────────
// These structs map directly to Rust types in src/main.rs.
// Slint generates type-safe Rust bindings for each.

export struct AlarmItem {
    id: string,
    label: string,
    time-display: string,   // "07:30"
    hour: int,
    minute: int,
    is-enabled: bool,
    repeat-days: string,    // "Weekdays", "Mon, Wed", "Once"
    is-vibrate: bool,
}

export struct WorldClockItem {
    city: string,
    country: string,
    timezone: string,
    time-display: string,   // "14:30 +1d"
    offset-display: string, // "UTC+9"
    diff-display: string,   // "+5h", "-3h", "Same time"
    is-daytime: bool,
}

// ── Material 3 Color Tokens ──────────────────────────────────────────────────
// These are the Material You tonal palette values.
// In a production app, these would be generated from the user's wallpaper
// using the Material Color Utilities algorithm.

export global MaterialTheme {
    // Primary tonal palette (purple-based default, overridden by dynamic color)
    out property <color> primary: #6750A4;
    out property <color> on-primary: #FFFFFF;
    out property <color> primary-container: #EADDFF;
    out property <color> on-primary-container: #21005D;

    // Secondary
    out property <color> secondary: #625B71;
    out property <color> on-secondary: #FFFFFF;
    out property <color> secondary-container: #E8DEF8;
    out property <color> on-secondary-container: #1D192B;

    // Tertiary (accent)
    out property <color> tertiary: #7D5260;
    out property <color> on-tertiary: #FFFFFF;
    out property <color> tertiary-container: #FFD8E4;

    // Error
    out property <color> error: #B3261E;
    out property <color> on-error: #FFFFFF;
    out property <color> error-container: #F9DEDC;

    // Surface / Background
    out property <color> surface: #FFFBFE;
    out property <color> surface-variant: #E7E0EC;
    out property <color> on-surface: #1C1B1F;
    out property <color> on-surface-variant: #49454F;
    out property <color> outline: #79747E;
    out property <color> outline-variant: #CAC4D0;

    // Navigation bar background
    out property <color> nav-bar: #F3EFF4;

    // Elevation overlays (Material 3 uses tonal elevation)
    out property <color> surface-1: #F4EFFE; // 5% primary overlay
    out property <color> surface-2: #F1ECF4; // 8% primary overlay
    out property <color> surface-3: #ECE6F0; // 11% primary overlay

    // Typography scale
    out property <length> display-large: 57px;
    out property <length> display-medium: 45px;
    out property <length> headline-large: 32px;
    out property <length> headline-medium: 28px;
    out property <length> title-large: 22px;
    out property <length> title-medium: 16px;
    out property <length> body-large: 16px;
    out property <length> body-medium: 14px;
    out property <length> label-large: 14px;
    out property <length> label-medium: 12px;
}

// ── Reusable Material Components ─────────────────────────────────────────────

// Material 3 Navigation Bar Item
component NavItem {
    in property <string> icon;
    in property <string> label;
    in property <bool> selected;
    callback clicked;

    width: 64px;
    height: 80px;

    Rectangle {
        x: (parent.width - 64px) / 2;
        y: 4px;
        width: 64px;
        height: 32px;
        border-radius: 16px;
        background: root.selected ? MaterialTheme.secondary-container : transparent;

        animate background { duration: 200ms; easing: ease-out; }

        Text {
            text: root.icon;
            font-size: 22px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    Text {
        x: 0;
        y: 44px;
        width: parent.width;
        text: root.label;
        font-size: MaterialTheme.label-medium;
        color: root.selected ? MaterialTheme.on-surface : MaterialTheme.on-surface-variant;
        horizontal-alignment: center;
        font-weight: root.selected ? 700 : 400;

        animate color { duration: 200ms; }
        animate font-weight { duration: 200ms; }
    }

    TouchArea {
        clicked => { root.clicked(); }
    }
}

// Material 3 FAB (Floating Action Button)
export component FAB {
    in property <string> icon: "+";
    callback clicked;

    width: 56px;
    height: 56px;

    Rectangle {
        border-radius: 16px;
        background: MaterialTheme.primary-container;
        drop-shadow-blur: 6px;
        drop-shadow-color: #00000040;
        drop-shadow-offset-y: 3px;

        Text {
            text: root.icon;
            font-size: 24px;
            color: MaterialTheme.on-primary-container;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        TouchArea {
            mouse-cursor: pointer;
            clicked => { root.clicked(); }
        }

        animate background { duration: 150ms; }
    }
}

// ── Root Application Window ──────────────────────────────────────────────────

export component AppWindow inherits Window {
    title: "Clock";
    preferred-width: 412px;  // Standard Android phone width
    preferred-height: 892px; // Standard Android phone height
    background: MaterialTheme.surface;

    // ── Properties: Clock Tab ─────────────────────────────────────────────
    in-out property <string> current-hour: "00";
    in-out property <string> current-minute: "00";
    in-out property <string> current-second: "00";
    in-out property <string> current-date: "Loading...";
    in-out property <bool> is-pm: false;

    // ── Properties: Alarm Tab ─────────────────────────────────────────────
    in-out property <[AlarmItem]> alarms: [];
    in-out property <bool> show-add-alarm: false;

    // ── Properties: Timer Tab ─────────────────────────────────────────────
    in-out property <int> timer-hours: 0;
    in-out property <int> timer-minutes: 5;
    in-out property <int> timer-seconds: 0;
    in-out property <bool> timer-running: false;
    in-out property <string> timer-display: "00:05:00";
    in-out property <float> timer-progress: 0.0;

    // ── Properties: Stopwatch Tab ─────────────────────────────────────────
    in-out property <string> stopwatch-display: "00:00.00";
    in-out property <bool> stopwatch-running: false;
    in-out property <[string]> laps: [];

    // ── Properties: World Clock Tab ───────────────────────────────────────
    in-out property <[WorldClockItem]> world-clocks: [];

    // ── Navigation State ──────────────────────────────────────────────────
    in-out property <int> active-tab: 0;
    // 0=Clock, 1=Alarm, 2=Timer, 3=Stopwatch, 4=WorldClock

    // ── Callbacks: Alarm ──────────────────────────────────────────────────
    callback add-alarm(int, int, string);   // hour, minute, label
    callback toggle-alarm(int, bool);       // index, enabled
    callback delete-alarm(int);             // index

    // ── Callbacks: Timer ──────────────────────────────────────────────────
    callback timer-start-pause(int, int, int);  // h, m, s
    callback timer-reset();
    callback timer-finished();               // fired by Slint when complete

    // ── Callbacks: Stopwatch ──────────────────────────────────────────────
    callback stopwatch-start-pause();
    callback stopwatch-reset();
    callback stopwatch-lap();

    // ── Layout ────────────────────────────────────────────────────────────
    // Responsive: on wide screens (tablet/TV), show navigation rail instead
    // of bottom navigation bar.
    property <bool> is-wide: self.width > 600px;

    // Main content area
    Rectangle {
        x: root.is-wide ? 80px : 0;
        y: 0;
        width: root.is-wide ? root.width - 80px : root.width;
        // Leave space for bottom nav on phone, none on wide
        height: root.is-wide ? root.height : root.height - 80px;

        // ── Tab Content ───────────────────────────────────────────────────
        // Only the active tab is visible. Slint optimizes rendering so
        // hidden components don't consume GPU resources.

        if root.active-tab == 0: ClockTab {
            width: 100%;
            height: 100%;
            hour: root.current-hour;
            minute: root.current-minute;
            second: root.current-second;
            date-text: root.current-date;
            is-pm: root.is-pm;
        }

        if root.active-tab == 1: AlarmTab {
            width: 100%;
            height: 100%;
            alarms: root.alarms;
            toggle-alarm(idx, en) => { root.toggle-alarm(idx, en); }
            delete-alarm(idx) => { root.delete-alarm(idx); }
            add-alarm-clicked => { root.show-add-alarm = true; }
        }

        if root.active-tab == 2: TimerTab {
            width: 100%;
            height: 100%;
            timer-hours: root.timer-hours;
            timer-minutes: root.timer-minutes;
            timer-seconds: root.timer-seconds;
            timer-running: root.timer-running;
            timer-display: root.timer-display;
            timer-progress: root.timer-progress;
            start-pause(h, m, s) => { root.timer-start-pause(h, m, s); }
            reset => { root.timer-reset(); }
        }

        if root.active-tab == 3: StopwatchTab {
            width: 100%;
            height: 100%;
            display: root.stopwatch-display;
            running: root.stopwatch-running;
            laps: root.laps;
            start-pause => { root.stopwatch-start-pause(); }
            reset => { root.stopwatch-reset(); }
            lap => { root.stopwatch-lap(); }
        }

        if root.active-tab == 4: WorldClockTab {
            width: 100%;
            height: 100%;
            clocks: root.world-clocks;
        }
    }

    // ── Bottom Navigation Bar (Phone Layout) ─────────────────────────────
    if !root.is-wide: Rectangle {
        x: 0;
        y: root.height - 80px;
        width: root.width;
        height: 80px;
        background: MaterialTheme.nav-bar;
        // Elevation border
        Rectangle {
            y: 0;
            width: parent.width;
            height: 1px;
            background: MaterialTheme.outline-variant;
        }

        HorizontalLayout {
            alignment: space-around;
            padding: 0;

            NavItem {
                icon: "🕐";
                label: "Clock";
                selected: root.active-tab == 0;
                clicked => { root.active-tab = 0; }
            }
            NavItem {
                icon: "🔔";
                label: "Alarm";
                selected: root.active-tab == 1;
                clicked => { root.active-tab = 1; }
            }
            NavItem {
                icon: "⏱";
                label: "Timer";
                selected: root.active-tab == 2;
                clicked => { root.active-tab = 2; }
            }
            NavItem {
                icon: "⏲";
                label: "Watch";
                selected: root.active-tab == 3;
                clicked => { root.active-tab = 3; }
            }
            NavItem {
                icon: "🌍";
                label: "World";
                selected: root.active-tab == 4;
                clicked => { root.active-tab = 4; }
            }
        }
    }

    // ── Navigation Rail (Wide/Tablet Layout) ──────────────────────────────
    if root.is-wide: Rectangle {
        x: 0;
        y: 0;
        width: 80px;
        height: root.height;
        background: MaterialTheme.surface-2;

        Rectangle {
            x: parent.width - 1px;
            width: 1px;
            height: parent.height;
            background: MaterialTheme.outline-variant;
        }

        VerticalLayout {
            padding-top: 32px;
            spacing: 8px;
            alignment: start;

            NavItem { icon: "🕐"; label: "Clock"; selected: root.active-tab == 0; clicked => { root.active-tab = 0; } }
            NavItem { icon: "🔔"; label: "Alarm"; selected: root.active-tab == 1; clicked => { root.active-tab = 1; } }
            NavItem { icon: "⏱"; label: "Timer"; selected: root.active-tab == 2; clicked => { root.active-tab = 2; } }
            NavItem { icon: "⏲"; label: "Watch"; selected: root.active-tab == 3; clicked => { root.active-tab = 3; } }
            NavItem { icon: "🌍"; label: "World"; selected: root.active-tab == 4; clicked => { root.active-tab = 4; } }
        }
    }

    // ── Add Alarm Dialog (Modal) ──────────────────────────────────────────
    if root.show-add-alarm: AddAlarmDialog {
        x: 0; y: 0;
        width: root.width;
        height: root.height;
        confirmed(h, m, label) => {
            root.add-alarm(h, m, label);
            root.show-add-alarm = false;
        }
        cancelled => { root.show-add-alarm = false; }
    }
}
